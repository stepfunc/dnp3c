<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>io.stepfunc</groupId>
    <artifactId>dnp3c</artifactId>
    <packaging>jar</packaging>
    <version>0.1.0-SNAPSHOT</version>

    <name>dnp3c</name>
    <description>DNP3 conformance test harness</description>
    <url>https://github.com/stepfunc/dnp3c</url>

    <organization>
        <name>Step Function I/O LLC</name>
        <url>https://stepfunc.io</url>
    </organization>

    <licenses>
        <license>
            <name>GPL-3.0-only</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Step Function I/O</name>
            <email>info@stepfunc.io</email>
            <organization>Step Function I/O LLC</organization>
            <organizationUrl>https://stepfunc.io</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/stepfunc/dnp3c</url>
        <connection>scm:git:https://github.com/stepfunc/dnp3c.git</connection>
        <developerConnection>scm:git:git@github.com:stepfunc/dnp3c.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the oldest Java the compiled classes run on -->
        <java.release>17</java.release>
        <!-- dependency versions -->
        <junit.version>4.13.2</junit.version>
        <scala.version>3.9.0</scala.version>
        <scalatest.version>3.2.20</scalatest.version>
        <scalatestplus.junit.version>3.2.20.0</scalatestplus.junit.version>
        <!-- submodule dependency versions -->
        <jansi.version>2.4.3</jansi.version>
        <commons-cli.version>1.11.0</commons-cli.version>
        <slf4j.version>2.0.20</slf4j.version>
        <pcap4j.version>1.8.2</pcap4j.version>
        <jserialcomm.version>2.11.4</jserialcomm.version>
        <!-- plugin versions -->
        <scala-maven-plugin.version>4.10.0</scala-maven-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven.spotless-plugin.version>3.10.4</maven.spotless-plugin.version>
        <scalafmt.version>3.11.5</scalafmt.version>
        <maven.surefire-plugin.version>3.6.0</maven.surefire-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    </properties>

    <build>
        <defaultGoal>package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- the licenses of the dependencies the CLI jar bundles (license-maven-plugin, below) -->
            <resource>
                <directory>src/license/texts</directory>
                <targetPath>META-INF/third-party/licenses</targetPath>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-sources/license</directory>
                <includes>
                    <include>THIRD-PARTY.txt</include>
                </includes>
                <targetPath>META-INF/third-party</targetPath>
            </resource>
            <resource>
                <directory>src/license</directory>
                <includes>
                    <include>licenses-resolved.xml</include>
                </includes>
                <targetPath>META-INF/third-party</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>${scala-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <recompileMode>incremental</recompileMode>
                    <args>
                        <arg>-release</arg>
                        <arg>${java.release}</arg>
                        <arg>-language:implicitConversions</arg>
                        <arg>-feature</arg>
                        <arg>-deprecation</arg>
                    </args>
                </configuration>
            </plugin>
            <plugin>
                <!-- formats the Scala sources and writes their license headers -->
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${maven.spotless-plugin.version}</version>
                <configuration>
                    <scala>
                        <scalafmt>
                            <version>${scalafmt.version}</version>
                            <file>${project.basedir}/.scalafmt.conf</file>
                        </scalafmt>
                        <licenseHeader>
                            <file>${project.basedir}/LICENSE_HEADER</file>
                            <delimiter>package </delimiter>
                        </licenseHeader>
                    </scala>
                </configuration>
                <executions>
                    <execution>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire-plugin.version}</version>
                <configuration>
                    <!-- the test classes are named *Test or *TestSuite -->
                    <includes>
                        <include>**/*Test*</include>
                    </includes>
                    <reportFormat>brief</reportFormat>
                    <useFile>false</useFile>
                </configuration>
            </plugin>
            <plugin>
                <!--
                  The licenses of the dependencies the CLI jar bundles: a list (THIRD-PARTY.txt), and each license's
                  text. The build fails on a license that isn't allowed. The texts are kept in src/license/texts, so a
                  build downloads only a license it hasn't seen, which then shows in git to be reviewed and committed.
                  src/license/licenses.xml corrects what the dependencies' POMs say.
                -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <configuration>
                    <excludedScopes>test,provided,system</excludedScopes>
                    <licenseMerges>
                        <licenseMerge>Apache-2.0|Apache Software License, Version 2.0|Apache License v2.0|Apache License, Version 2.0</licenseMerge>
                        <licenseMerge>MIT|MIT License</licenseMerge>
                        <licenseMerge>LGPL-2.1|LGPL, version 2.1</licenseMerge>
                        <licenseMerge>LGPL-3.0|GNU Lesser GPL, Version 3</licenseMerge>
                    </licenseMerges>
                    <!-- licenses compatible with GPL-3.0-only; a dependency needs one of them -->
                    <includedLicenses>
                        <includedLicense>Apache-2.0</includedLicense>
                        <includedLicense>MIT</includedLicense>
                    </includedLicenses>
                    <failOnBlacklist>true</failOnBlacklist>
                    <failOnMissing>true</failOnMissing>
                    <addOutputDirectoryAsResourceDir>false</addOutputDirectoryAsResourceDir>
                    <!-- the texts, and which dependency each is for: both committed, so that the build reads them
                         rather than downloads them, and whatever changes in them shows in git; nothing is deleted,
                         and the build doesn't depend on Maven's offline mode -->
                    <licensesOutputDirectory>${project.basedir}/src/license/texts</licensesOutputDirectory>
                    <licensesOutputFile>${project.basedir}/src/license/licenses-resolved.xml</licensesOutputFile>
                    <removeOrphanLicenseFiles>false</removeOrphanLicenseFiles>
                    <sortByGroupIdAndArtifactId>true</sortByGroupIdAndArtifactId>
                    <offline>false</offline>
                    <errorRemedy>failFast</errorRemedy>
                    <licenseUrlReplacements>
                        <licenseUrlReplacement>
                            <regexp>\Qhttps://www.apache.org/licenses/LICENSE-2.0\E(\.txt)?</regexp>
                            <replacement>https://www.apache.org/licenses/LICENSE-2.0.txt</replacement>
                        </licenseUrlReplacement>
                        <licenseUrlReplacement>
                            <regexp>\Qhttp://www.apache.org/licenses/LICENSE-2.0\E(\.txt)?</regexp>
                            <replacement>https://www.apache.org/licenses/LICENSE-2.0.txt</replacement>
                        </licenseUrlReplacement>
                    </licenseUrlReplacements>
                    <!-- local names for the texts, with checksums of what they should be -->
                    <licenseUrlFileNames>
                        <apache-2.0.txt>
                            sha1:2b8b815229aa8a61e483fb4ba0588b8b6c491890
                            \Qhttps://www.apache.org/licenses/LICENSE-2.0.txt\E
                        </apache-2.0.txt>
                        <mit-pcap4j.txt>
                            sha1:354c9d694964180b61f6ab630cd9b5456d373f5b
                            \Qhttps://raw.githubusercontent.com/kaitoy/pcap4j/\E.*
                        </mit-pcap4j.txt>
                        <mit-slf4j.txt>
                            sha1:961528e4584043f215e2fc740f5d37dc9e72485f
                            \Qhttps://raw.githubusercontent.com/qos-ch/slf4j/\E.*
                        </mit-slf4j.txt>
                        <notice-jserialcomm.txt>
                            sha1:04ac407bf32f707f5d5d165a2b64a7deb39288fd
                            \Qhttps://raw.githubusercontent.com/Fazecast/jSerialComm/\E.*/NOTICE
                        </notice-jserialcomm.txt>
                        <notice-scala.md>
                            sha1:3779faf6d2234d1205d0282fc8aa4645ae21ccc1
                            \Qhttps://raw.githubusercontent.com/scala/scala3/\E.*/NOTICE\.md
                        </notice-scala.md>
                    </licenseUrlFileNames>
                </configuration>
                <executions>
                    <execution>
                        <id>third-party</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-third-party</goal>
                            <goal>download-licenses</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- the library jar, which plugins depend on -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
            </plugin>
            <plugin>
                <!-- a runnable jar with every dependency, attached with the classifier "cli" -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>cli</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.stepfunc.dnp3c.conformance.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- the dependencies' NOTICE files, merged; their own LICENSE files, which would
                                     overwrite each other, are left out for META-INF/third-party -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- the CLI download: the runnable jar with launcher scripts that check for Java -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/cli.xml</descriptor>
                            </descriptors>
                            <finalName>dnp3c-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- what Maven Central needs besides the jar and the pom: the sources and the docs, as jars -->
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <!-- Central requires a javadoc jar; scaladoc 3.9 can't build one (it fails on its own Jackson
                             dependencies), so it carries the user guides, which document the plugin API -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-docs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}/docs</classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>net.alchim31.maven</groupId>
                        <artifactId>scala-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <!-- so the sources jar has the Scala sources -->
                                <id>add-scala-sources</id>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <!-- pcap4j depends on slf4j-api 1.7, which can't find slf4j-nop 2's provider -->
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
            <version>${scala.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.fusesource.jansi</groupId>
            <artifactId>jansi</artifactId>
            <version>${jansi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pcap4j</groupId>
            <artifactId>pcap4j-core</artifactId>
            <version>${pcap4j.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.pcap4j</groupId>
            <artifactId>pcap4j-packetfactory-static</artifactId>
            <version>${pcap4j.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>${jserialcomm.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>${commons-cli.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_3</artifactId>
            <version>${scalatest.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.scalatestplus</groupId>
            <artifactId>junit-4-13_3</artifactId>
            <version>${scalatestplus.junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>